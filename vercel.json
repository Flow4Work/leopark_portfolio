{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/check-site.mjs",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/profile",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/perspective",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/perspective.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/planning-agent",
      "destination": "/law-project",
      "permanent": true
    }
  ],
  "installCommand": "node scripts/check-activity.cjs",
  "rewrites": [
    {
      "source": "/eng",
      "destination": "/eng/index.html"
    },
    {
      "source": "/eng/law-project",
      "destination": "/eng/law-project.html"
    },
    {
      "source": "/eng/kol-scout",
      "destination": "/eng/kol-scout.html"
    },
    {
      "source": "/eng/instagram-card-agent",
      "destination": "/eng/instagram-card-agent.html"
    },
    {
      "source": "/eng/kokochizu",
      "destination": "/eng/kokochizu.html"
    },
    {
      "source": "/eng/tonament",
      "destination": "/eng/tonament.html"
    },
    {
      "source": "/eng/chiklink",
      "destination": "/eng/chiklink.html"
    },
    {
      "source": "/eng/ownerbe",
      "destination": "/eng/ownerbe.html"
    }
  ]
}
